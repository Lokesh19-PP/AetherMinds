{
  "name": "proofchain",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "seed": "tsx scripts/seed.ts",
    "dev": "concurrently \"npm run dev -w apps/registry\" \"npm run dev -w apps/web\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.5.0"
  }
}
